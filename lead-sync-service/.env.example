# Bitrix24 webhook URL для создания лидов
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-webhook-key

# Секретный ключ для проверки входящих webhook-запросов
WEBHOOK_SECRET_KEY=your-secret-key

# Настройки сервера
PORT=3000
NODE_ENV=development

# Bitrix24
BITRIX24_DEAL_STAGE=NEW

# Дополнительные опции
ENABLE_DUPLICATE_CHECK=true
LOG_LEVEL=info
