```gitignore
# Dependencies
node_modules/
.jest/
.nyc_output/
coverage/
.npm/
.yarn/

# Environment variables
.env
.env.local
.env.*
!.env.example

# Build outputs
dist/
build/
.next/
out/
lib/
tmp/
temp/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Logs
*.log

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/

# Node.js specific (if applicable)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript specific (since we have .ts files)
*.tsbuildinfo
```